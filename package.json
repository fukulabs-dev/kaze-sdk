{
  "name": "@fukulabs/kaze-sdk",
  "version": "0.1.0-beta.0",
  "description": "Kaze: React Native Client SDK for Over-The-Air updates by fukulabs.dev",
  "license": "MIT",
  "homepage": "https://github.com/fukulabs/kaze-sdk#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/fukulabs/kaze-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/fukulabs/kaze-sdk/issues"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-plugin",
    "ota",
    "over-the-air",
    "updates",
    "turbomodule",
    "kaze"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./plugin/dist/index.d.ts",
      "import": "./plugin/dist/index.js",
      "default": "./plugin/dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "android",
    "ios",
    "plugin/dist",
    "README.md",
    "LICENSE",
    "kaze-sdk.podspec"
  ],
  "codegenConfig": {
    "name": "OtaModuleSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.otarn"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && tsc -p plugin",
    "test": "vitest run",
    "prepublishOnly": "npm run test && npm run build"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.8.7",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
