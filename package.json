{
  "name": "@fukulabs/kaze",
  "version": "0.1.0",
  "description": "Kaze: React Native Client SDK for Over-The-Air updates by fukulabs.dev",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./plugin/dist/index.d.ts",
      "import": "./plugin/dist/index.js",
      "default": "./plugin/dist/index.js"
    }
  },
  "files": [
    "dist",
    "android",
    "ios",
    "plugin/dist",
    "README.md",
    "fukulabs-kaze.podspec"
  ],
  "scripts": {
    "build": "tsc && tsc -p plugin",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.8.7",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
